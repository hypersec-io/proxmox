{
  "name": "proxmox-postinstall-toolkit",
  "description": "Idempotent scripts for configuring Proxmox VE installations",
  "private": true,
  "scripts": {
    "lint": "shellcheck -x *.sh ../tests/*.sh",
    "test": "bash -n *.sh ../tests/*.sh && shellcheck -x *.sh ../tests/*.sh && ../tests/test-update-policy.sh && ../tests/test-disk-errors.sh && ../tests/test-cleanup.sh && ../tests/test-apt-pinning.sh",
    "semantic-release": "semantic-release"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hyperi-io/proxmox.git"
  },
  "keywords": [
    "proxmox",
    "virtualization",
    "optimization",
    "debian",
    "zfs",
    "power-management",
    "bash",
    "automation"
  ],
  "author": "HyperSec",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/hyperi-io/proxmox/issues"
  },
  "homepage": "https://github.com/hyperi-io/proxmox#readme",
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^10.0.0",
    "@semantic-release/release-notes-generator": "^14.0.0",
    "semantic-release": "^24.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
